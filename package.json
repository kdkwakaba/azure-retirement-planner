{
  "name": "azure-retirement-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "security": "npm audit --audit-level=low",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "volta": {
    "node": "24.22.1",
    "npm": "11.20.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
